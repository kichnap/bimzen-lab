# ============================================================================
# ПАНЧИК.РФ
# Что НЕ попадает в репозиторий
# ============================================================================

# --- Артефакты сборки ---
bin/
obj/
.vs/
*.user
*.suo
TestResults/
artifacts/

# --- Логи и временные файлы прогонов ---
*.log
*.tmp

# --- Внутренняя кухня ---
# Рабочие журналы, задания и инструкции для агентов ведутся локально
# и в публичный репозиторий не попадают.
AGENTS.md
CLAUDE.md
AGENT_PROMPT.md
TASKS.md
CODE_REVIEW.md
NOTES.md
VPN_PLAN.md
Инструкция.docx
Инструкция.pdf

# --- Боевые настройки ---
# В репозитории живут только шаблоны: рабочие конфиги содержат адреса
# серверов, UNC-пути к проектным папкам и имена площадок.
config.json
settings.json
!config.template.json
!settings.template.json

# --- Модели Revit и производные форматы ---
# Двоичные, десятки мегабайт, содержат проектные данные заказчиков.
# Тестовые модели держим локально, в git они не нужны и вредны:
# из истории git такие файлы потом не вычистить простым удалением.
*.rvt
*.rfa
*.rte
*.nwc
*.nwd
*.ifc
*.rvt.[0-9][0-9][0-9][0-9]

# --- Готовые поставки ---
# dist собирается из исходников командой build.ps1 и полностью
# воспроизводим. Держать его в git — значит хранить артефакты, которые
# устаревают в тот же день. Архивы поставок (*.zip) тем более не храним:
# внутри может оказаться боевой config.json.
dist/
temp/
*.zip

# Папки с тестовыми моделями целиком
03_Upload to RevitServer/docs/
**/Revit_temp/
**/*_backup/
